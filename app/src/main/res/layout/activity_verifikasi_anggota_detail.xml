<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_base">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A237E"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#FFFFFF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/da_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_nama"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/da_accent_text" />

                        <TextView
                            android:id="@+id/tv_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="@color/da_text_tertiary" />

                        <TextView
                            android:id="@+id/tv_telepon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="14sp"
                            android:textColor="@color/da_text_tertiary" />

                        <TextView
                            android:id="@+id/tv_kelompok"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="14sp"
                            android:textColor="@color/da_text_tertiary" />

                        <TextView
                            android:id="@+id/tv_desa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:textColor="@color/da_text_tertiary" />

                        <TextView
                            android:id="@+id/tv_tempat_tanggal_lahir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="14sp"
                            android:textColor="@color/da_text_tertiary" />

                        <TextView
                            android:id="@+id/tv_alamat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="14sp"
                            android:textColor="@color/da_text_tertiary" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ═══════ Dokumen KTP ═══════ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/da_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🪪  Dokumen KTP"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/da_accent_text"
                            android:layout_marginBottom="10dp"/>

                        <Button
                            android:id="@+id/btn_lihat_foto_ktp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lihat Foto KTP"
                            android:textAllCaps="false"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/tv_foto_ktp_kosong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Foto KTP belum diunggah"
                            android:textSize="13sp"
                            android:textColor="@color/da_text_tertiary"
                            android:visibility="gone"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- ═══════ akhir Dokumen KTP ═══════ -->

                <!-- ═══════ BARU: Jadikan Ketua Kelompok ═══════ -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_jadikan_ketua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/da_card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👑  Status Ketua Kelompok"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/da_accent_text"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/tv_info_ketua"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/da_text_tertiary"
                            android:layout_marginBottom="8dp"
                            android:visibility="gone"/>

                        <CheckBox
                            android:id="@+id/cb_jadikan_ketua"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Jadikan Ketua Kelompok"
                            android:textSize="14sp"
                            android:textColor="@color/da_accent_text"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <!-- ═══════ akhir tambahan Jadikan Ketua Kelompok ═══════ -->

                <LinearLayout
                    android:id="@+id/layout_tombol_verifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btn_tolak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Tolak"
                        android:backgroundTint="@color/status_ditolak"
                        android:textColor="@android:color/white" />

                    <Button
                        android:id="@+id/btn_verifikasi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Verifikasi"
                        android:backgroundTint="@color/status_disetujui"
                        android:textColor="@android:color/white" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>