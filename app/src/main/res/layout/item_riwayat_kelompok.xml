<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_info_box"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <!-- Baris nama anggota + badge Pengaju -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_nama_anggota_kelompok"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/admin_text_primary"/>

        <TextView
            android:id="@+id/tv_badge_pengaju"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaju"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FF1565C0"
            android:background="@drawable/bg_info_box"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Ringkasan jumlah kredit lunas / aktif / macet -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_jumlah_lunas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/status_disetujui"
            android:background="@drawable/bg_badge_disetujui"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tv_jumlah_aktif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/status_menunggu"
            android:background="@drawable/bg_badge_menunggu"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/tv_jumlah_macet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/status_ditolak"
            android:background="@drawable/bg_badge_ditolak"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>

    </LinearLayout>

    <!-- Pesan kalau anggota ini belum punya transaksi individual -->
    <TextView
        android:id="@+id/tv_transaksi_kosong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada transaksi individual"
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="#FF757575"
        android:layout_marginTop="2dp"
        android:visibility="gone"/>

    <!-- Tempat baris item_transaksi_kelompok di-inflate satu per satu -->
    <LinearLayout
        android:id="@+id/container_transaksi_anggota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp"
        android:visibility="gone"/>

</LinearLayout>