<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dashboard_base">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A237E"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#FFFFFF"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Kelola Proposal -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_proposal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_blue"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_description_24" app:tint="#1565C0" android:contentDescription="Kelola Proposal"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kelola Proposal" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kelola pengajuan pinjaman dari anggota" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data Anggota -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_anggota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_teal"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_group_24" app:tint="#00796B" android:contentDescription="Data Anggota"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Data Anggota" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kelola data anggota BUMDesma" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Verifikasi Anggota Baru -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_verifikasi_anggota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_orange"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_verified_24" app:tint="#E65100" android:contentDescription="Verifikasi Anggota Baru"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Verifikasi Anggota Baru" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Verifikasi data anggota yang baru mendaftar" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Angsuran -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_angsuran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_green"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_payments_24" app:tint="#2E7D32" android:contentDescription="Angsuran"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Angsuran" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Catat dan kelola pembayaran angsuran" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Laporan -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_laporan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_orange"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_bar_chart_24" app:tint="#E65100" android:contentDescription="Laporan Keuangan"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Laporan" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lihat laporan keuangan dan statistik" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Riwayat Aktivitas -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_riwayat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_purple"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_history_24" app:tint="#6A1B9A" android:contentDescription="Riwayat Aktivitas"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Riwayat Aktivitas" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Lihat riwayat aktivitas sistem" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Informasi -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pengumuman"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/da_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="14dp">
                        <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_box_red"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                            android:src="@drawable/ic_campaign_24" app:tint="#C62828" android:contentDescription="Informasi"/>
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Informasi" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/da_accent_text"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Kelola informasi dan pengumuman" android:textSize="11sp" android:textColor="@color/da_text_tertiary"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/da_text_tertiary"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/da_card_bg"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav_admin" />

</LinearLayout>