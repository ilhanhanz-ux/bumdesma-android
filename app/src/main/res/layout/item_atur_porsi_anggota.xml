<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_info_box"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tv_nama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/da_text_primary"
            tools:text="Ilhan" />

        <TextView
            android:id="@+id/tv_status_kunci"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/da_text_tertiary"
            android:visibility="gone"
            tools:text="Sudah disetor, tidak bisa diubah"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        app:hintEnabled="false"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/admin_input_stroke">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_nominal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:gravity="end"
            android:textSize="14sp"
            android:textColor="@color/da_text_primary"
            android:textColorHint="@color/da_text_tertiary"
            android:hint="0"
            android:paddingVertical="10dp" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>