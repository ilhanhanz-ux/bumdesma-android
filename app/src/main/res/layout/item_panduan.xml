<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/da_card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/containerPanduan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <ImageView
                android:id="@+id/ivIconPanduan"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                app:tint="@color/da_primary"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvJudulPanduan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/da_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Judul Topik Panduan" />

            <ImageView
                android:id="@+id/ivChevronPanduan"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:tint="@color/da_text_secondary"
                tools:ignore="ContentDescription" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvIsiPanduan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:paddingHorizontal="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/da_text_secondary"
            android:textSize="13.5sp"
            android:visibility="gone"
            tools:text="Isi penjelasan langkah-langkah panduan..."
            tools:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>