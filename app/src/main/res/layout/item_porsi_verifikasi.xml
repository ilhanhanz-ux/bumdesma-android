<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:cardBackgroundColor="@color/da_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="8dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/iv_bukti_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Bukti setor"
                    tools:src="@drawable/ic_placeholder_image" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_nama_anggota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/da_text_primary"
                    tools:text="Muhamad Ilhan Maulana Aziz" />

                <TextView
                    android:id="@+id/tv_nama_kelompok"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/da_text_tertiary"
                    tools:text="Kelompok Sejahtera" />

                <TextView
                    android:id="@+id/tv_angsuran_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="@color/da_text_tertiary"
                    tools:text="Angsuran ke-2 • KRD-20260729-0008" />

                <TextView
                    android:id="@+id/tv_nominal_porsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/da_accent_text"
                    tools:text="Rp 58.796" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_tanggal_setor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11sp"
            android:textColor="@color/da_text_tertiary"
            tools:text="Disetor: 08 Agustus 2026" />

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_status_badge"
            android:visibility="gone"
            tools:text="DITOLAK"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_catatan_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/da_danger_text"
            android:visibility="gone"
            tools:text="Alasan: foto buram, mohon upload ulang"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layout_aksi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Tolak"
                android:textSize="12sp"
                android:textColor="@color/da_danger_text"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_approve"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Setujui"
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#FF2E7D32" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>